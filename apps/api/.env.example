# Postgres connection used by Drizzle and drizzle-kit.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/url_shortener

# Port the Nest API listens on.
PORT=3000

# Exact origin of the deployed React app (no wildcard) - required for
# credentialed CORS to work with the httpOnly session cookie.
WEB_ORIGIN=http://localhost:5173

# Cookie domain for the session cookie. Use a shared registrable domain
# (e.g. .nook.sh) in production so the cookie is sent to both the app's
# and the API's subdomains; leave unset for local development (host-only cookie).
# SESSION_COOKIE_DOMAIN=.nook.sh

# Secret used to sign the opaque session cookie value (HMAC). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-in-production
