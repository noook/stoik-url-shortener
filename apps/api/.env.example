# Postgres connection used by Drizzle and drizzle-kit.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/url_shortener

# Port the Nest API listens on.
PORT=3000

# Exact origin of the deployed React app (no wildcard) - required for
# credentialed CORS to work with the httpOnly auth-token cookie.
WEB_ORIGIN=http://localhost:5173

# Third-party ad service the API proxies homepage ad requests to (GET
# /api/ads). The token is never exposed to the browser - only the API
# holds it and attaches it as an outbound Authorization: Bearer header.
# URL defaults to the assessment's ad service if unset; the token has no
# default and must be set for /api/ads to work.
ADS_API_URL=https://stoik-technical-test-js-admin.vercel.app/api/ads
ADS_API_TOKEN=changeme
