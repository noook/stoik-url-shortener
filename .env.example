# Copy to .env before running `pnpm docker:up` / `docker compose up --build`.

# Postgres credentials for the `postgres` compose service. The API's
# DATABASE_URL is built from these automatically - see docker-compose.yml.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Optional - defaults shown. Only need to change these if the ports are
# already taken on the host.
POSTGRES_DB=url_shortener
API_PORT=3000
WEB_PORT=8080

# Only matters if something calls the API directly at its own origin rather
# than through the web container's /api reverse proxy (which is same-origin
# and isn't subject to CORS at all). Set to wherever the web container is
# actually reachable from a browser.
WEB_ORIGIN=http://localhost:8080

# Homelab-only (docker-compose.homelab.yml, not the base compose file).
# Real hostname the shared Traefik instance routes to this project - see
# docs/homelab-deployment-notes.md. Leave unset when using the base
# docker-compose.yml alone.
# HOMELAB_HOSTNAME=go.example.com
